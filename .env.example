# Copia a .env y completa. .env NO se versiona.
APP_ENV=development
PORT=8880
BASE_URL=https://tu-dominio.example
LOG_LEVEL=info
# Carpeta de las campañas: Excel original, campaign.json y events.jsonl (auditoría). Contiene datos de menores.
DATA_DIR=data

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

CHATWOOT_URL=http://127.0.0.1:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=2

# Hoja de Google publicada como CSV (Archivo > Compartir > Publicar en la web > CSV).
# Opcional: también se puede cambiar desde la pantalla de configuración sin reiniciar.
SHEETS_CSV_URL=

# Redis propio de Visoria (docker compose up -d). Obligatorio.
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

# Documentos: plantillas Word -> PDF con LibreOffice (apt install libreoffice-writer).
# SOFFICE_PATH=/usr/bin/soffice
# DOCS_BATCH_SIZE=25
# DOCS_TIMEOUT=10m
# Si LibreOffice viene por snap no puede leer /tmp: use una carpeta de su home (no oculta).
# DOCS_WORKDIR=

# Envío por WhatsApp (plantilla aprobada en Meta) y por correo (Gmail).
# WHATSAPP_TEMPLATE=purchase_receipt_3
# WHATSAPP_LANGUAGE=es_CO
# WHATSAPP_RATE_PER_SEC=5
# Correo: contraseña de APLICACIÓN de Gmail (16 letras), no la contraseña normal.
# SMTP_USER=cuenta@gmail.com
# SMTP_APP_PASSWORD=
# SMTP_DAILY_QUOTA=450
# MAIL_WHATSAPP=3228467206
# Seguridad para pruebas: si se define, SOLO se envía a estos móviles/correos (separados por coma).
# DISPATCH_ALLOWLIST=573209323449,mi-correo@example.com

# Enlaces firmados (PDF en las notas de Chatwoot y descarga del ZIP desde el panel).
# Genere el secreto con:  openssl rand -hex 32   (mínimo 32 caracteres; vacío = sin enlaces)
LINK_SECRET=
# Días de vigencia del enlace al PDF que va en la nota de Chatwoot
PDF_LINK_DAYS=30
